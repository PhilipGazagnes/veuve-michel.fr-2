# Content Delivery API token (Storyblok space Settings → Access Tokens → Preview).
# Used by @storyblok/nuxt at runtime to fetch content.
STORYBLOK_PREVIEW_TOKEN=

# Space ID (numeric, no leading #).
STORYBLOK_SPACE_ID=

# Management API Personal Access Token (Account settings → Personal access tokens).
# Only needed to run scripts/seed-storyblok.mjs — not required at runtime.
STORYBLOK_MANAGEMENT_TOKEN=

STORYBLOK_REGION=eu

# Protection de /aide (guide interne) — à définir uniquement dans les variables
# d'environnement du site sur Netlify (Site settings → Environment variables), pas en
# local : lues par netlify/edge-functions/aide-auth.ts, sans effet en `nuxt dev`.
AIDE_USER=
AIDE_PASSWORD=
